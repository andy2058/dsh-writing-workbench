{
  "name": "@lao-ou/dsh-writing-workbench",
  "version": "0.11.2",
  "private": true,
  "description": "老欧写作工作台：六阶段公众号写作提示词流水线（选题 → 结构 → 润色 → 传播优化 → 标题封面 → 自检），并把同一套提示词注册成 7 个 agent skill。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "templates",
    "ui",
    "tools",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.js",
    "check": "node tools/build.js --check",
    "smoke": "node tools/smoke.mjs",
    "smoke:render": "node tools/render-smoke.mjs",
    "verify": "node tools/build.js && node --check lib/client.js && node tools/smoke.mjs && node tools/render-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andy2058/dsh-writing-workbench.git"
  },
  "homepage": "https://github.com/andy2058/dsh-writing-workbench",
  "license": "MIT"
}
